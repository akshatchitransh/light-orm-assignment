  "compilerOptions": {
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@light-orm/core": ["./packages/orm/src/index.ts"]
    }
  },
  "include": ["api/**/*", "serverless/**/*", "examples/**/*"]
}
